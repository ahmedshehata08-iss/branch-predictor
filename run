#!/usr/bin/env python3
"""Author: Ahmed Ahmed. Portable replacement for the supplied csh/dc runner."""
import pathlib
import subprocess
import sys
if len(sys.argv) not in (2,3):
    sys.exit('Usage: ./run TRACE_DIRECTORY [pm|bimodal|gshare|always_taken]')
root=pathlib.Path(__file__).resolve().parent
traces=sorted(pathlib.Path(sys.argv[1]).rglob('*.trace.*'))
if not traces: sys.exit('No trace files found')
mode=sys.argv[2] if len(sys.argv)==3 else 'pm'
values=[]
for trace in traces:
    result=subprocess.run([str(root/'src/predict'),str(trace),mode,'--stats'],
                          check=True,capture_output=True,text=True)
    import json
    value=json.loads(result.stdout.splitlines()[0])['mpki']
    values.append(value)
    print(f'{str(trace):55s} {value:.3f}',flush=True)
print(f'average MPKI: {sum(values)/len(values):.3f}')
